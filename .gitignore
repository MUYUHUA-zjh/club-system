# ============================================================
# 隐私 / 敏感数据 —— 切勿上传 GitHub
# ============================================================

# 本地数据库（含学生/会员个人身份信息：姓名、学号、手机、邮箱等 PII）
server/data/

# 用户上传文件（头像、证件、活动附件等）
server/uploads/*
!server/uploads/.gitkeep

# 运行日志（可能记录请求与用户信息）
*.log
server/server.log

# 环境变量 / 密钥（本地使用，切勿提交；模板可保留 .env.example）
.env
.env.*
!.env.example

# ============================================================
# 依赖 / 构建产物（体积大、可重新生成，无需入库）
# ============================================================
node_modules/
dist/
web/node_modules/
server/node_modules/

# Vite 临时文件
vite.config.ts.timestamp-*.mjs

# ============================================================
# 系统 / 编辑器 / 缓存
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tsbuildinfo
.cache/
coverage/
